# ============================================================================
# Zodiac Bank AI Security Lab — environment template
#
# Copy to `.env` (gitignored) and edit. Every value has a sane fallback in
# docker-compose.yml, so a plain `docker compose up` works; this file is only
# needed when you want to pin a value or run strict security mode.
#
#   cp .env.example .env
#   make up          # or: ./scripts/start_all.sh
# ============================================================================

# ---------------------------------------------------------------------------
# Runtime profile: core | lite | full
#   core — Training Gate, Challenge Surface, Graph Context, Aurora/Phoenix/
#          Assistant, and the inference backend. ~8 GB RAM.
#   lite — core + A2A router/knowledge agent + MCP server/wrapper. ~12 GB.
#   full — lite + Kong, storage (Chroma/Milvus/Redis/LightRAG/Mem0), SIEM
#          (Elasticsearch/Kibana/Filebeat). ~48 GB.
# ---------------------------------------------------------------------------
LAB_MODE=core
# Seed storage/memories on full-profile startup (1) or skip (0).
SEED_DATA=0

# ---------------------------------------------------------------------------
# Inference backend
#
# The lab never downloads a model. It auto-detects Ollama, LM Studio, or an
# existing llama.cpp server; otherwise it uses the local Bonsai GGUF fallback.
#
# Any GGUF works — drop a smaller model under ./models for a lighter start.
# The file is discovered automatically:
#   cp /path/to/your-model.gguf models/
# ---------------------------------------------------------------------------
INFERENCE_PROVIDER=auto            # auto | bonsai | ollama | lmstudio | llamacpp
INFERENCE_MODEL=                   # optional; leave empty to auto-detect
BONSAI_MODEL_DIR=./models          # where the local GGUF lives
BONSAI_MODEL_FILE=bonsai-27b.gguf  # name of the GGUF (any GGUF is fine)
BONSAI_CONTEXT_SIZE=2048
BONSAI_PARALLEL=1
BONSAI_GPU_LAYERS=0                # set >0 to offload layers to GPU
BONSAI_MEMORY_LIMIT=5G
INFERENCE_CONTAINER_HOST=host.docker.internal   # podman: host.containers.internal

# ---------------------------------------------------------------------------
# Security mode
#
#   strict — requires strong, non-placeholder secrets (recommended for cohorts).
#            `./scripts/bootstrap_secrets.sh` generates them into .env.
#   development — permissive defaults for disposable local smoke tests only.
# ---------------------------------------------------------------------------
TRAINING_SECURITY_MODE=strict
GRAPH_CONTEXT_SECURITY_MODE=strict
AGENT_SECURITY_MODE=strict

# Leave these empty; `make env` / `bootstrap_secrets.sh` will generate them.
# Set them explicitly only to reuse an existing cohort's secrets.
TRAINING_FLAG_SECRET=
TRAINING_ADMIN_KEY=
GRAPH_CONTEXT_API_KEY=
ZODIAC_AGENT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Hard-gate tuning (optional)
# ---------------------------------------------------------------------------
TRAINING_MAX_SUBMISSIONS=20
TRAINING_FLAG_COOLDOWN_SECONDS=0

# ---------------------------------------------------------------------------
# Full-profile extras (only used with LAB_MODE=full)
#
# LightRAG and Mem0 need a separate *embedding* provider; Bonsai is a text
# generator and does not produce embeddings. Configure these before seeding.
# ---------------------------------------------------------------------------
ENABLE_EXTERNAL_CONTEXT=0
LIGHTRAG_EMBEDDING_BINDING=openai
LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-small
LIGHTRAG_EMBEDDING_HOST=https://api.openai.com/v1
LIGHTRAG_EMBEDDING_API_KEY=
LIGHTRAG_EMBEDDING_DIM=1536
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_MODEL=text-embedding-3-small
MEM0_EMBEDDER_HOST=https://api.openai.com/v1
MEM0_EMBEDDER_API_KEY=
MEM0_ADMIN_API_KEY=
MEM0_JWT_SECRET=
