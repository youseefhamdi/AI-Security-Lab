{
  "schema_version": 1,
  "ruleset_id": "zodiac-bank-ai-detection-v1",
  "classification": "synthetic-training-only",
  "defaults": {
    "scope": "localhost-only",
    "retention_days": 7,
    "side_effects": false,
    "privacy": "record hashes, counters, and synthetic IDs; never raw secrets or customer content"
  },
  "rules": [
    {
      "id": "ZB-AI-001",
      "title": "Instruction-like content crosses an AI trust boundary",
      "severity": "high",
      "log_sources": ["aurora", "zodiac-context", "a2a-knowledge"],
      "when": ["retrieved.trust == retrieved-untrusted-data", "retrieved.instruction_like == true"],
      "mitre_atlas": ["prompt injection"],
      "response": ["quarantine the evidence", "preserve packet_id", "require human review"]
    },
    {
      "id": "ZB-AI-002",
      "title": "Tool or model manifest changed outside an approved update",
      "severity": "high",
      "log_sources": ["mcp-wrapper", "dependency-sweeper", "orchestrator"],
      "when": ["manifest.digest != approved.digest", "approval.id is null"],
      "mitre_attack": ["Supply Chain Compromise", "Poisoned Pipeline Execution"],
      "response": ["deny capability refresh", "quarantine the manifest", "open a supply-chain case"]
    },
    {
      "id": "ZB-AI-003",
      "title": "Agent request volume or fan-out exceeds baseline",
      "severity": "medium",
      "log_sources": ["aurora", "assistant", "a2a-router", "training-challenges"],
      "when": ["requests.per_minute > baseline * 3", "worker_fan_out > declared_limit"],
      "mitre_attack": ["Exfiltration Over Web Service", "Account Discovery"],
      "response": ["apply a circuit breaker", "retain aggregate counters", "request operator approval"]
    },
    {
      "id": "ZB-AI-004",
      "title": "Identity, role, or approval context is inconsistent",
      "severity": "critical",
      "log_sources": ["training-gate", "kong", "a2a-router", "zodiac-context"],
      "when": ["claimed_identity != authenticated_identity", "role_change without approval", "proxy_identity_used == true"],
      "mitre_attack": ["Valid Accounts", "Account Discovery", "Permission Groups Discovery"],
      "response": ["deny the action", "rotate the synthetic session", "escalate to compliance"]
    },
    {
      "id": "ZB-AI-005",
      "title": "Memory or graph evidence crosses tenant or provenance scope",
      "severity": "critical",
      "log_sources": ["mem0", "chromadb", "lightrag", "zodiac-context"],
      "when": ["requested_scope != record_scope", "provenance.synthetic != true", "allowed_entity_ids expanded"],
      "mitre_atlas": ["data poisoning"],
      "response": ["reject the record", "quarantine the source", "invalidate the context packet"]
    },
    {
      "id": "ZB-AI-006",
      "title": "Detector result changes after safe canonicalization",
      "severity": "high",
      "log_sources": ["filebeat", "elasticsearch", "training-challenges"],
      "when": ["normalized_hash == baseline_hash", "decision.normal != decision.encoded"],
      "mitre_attack": ["Obfuscated Files or Information", "Deobfuscate/Decode Files or Information"],
      "response": ["canonicalize before matching", "record both representations as hashes", "open detection-gap task"]
    },
    {
      "id": "ZB-AI-007",
      "title": "MCP tool description or schema drift",
      "severity": "high",
      "log_sources": ["mcp-server", "mcp-wrapper", "a2a-router"],
      "when": ["tool.description_hash changed", "tool.schema_hash changed", "server_version not pinned"],
      "mitre_atlas": ["AI supply-chain compromise"],
      "response": ["stop tool use", "compare signed metadata", "require explicit re-approval"]
    },
    {
      "id": "ZB-AI-008",
      "title": "Privileged worker route selected from untrusted input",
      "severity": "critical",
      "log_sources": ["orchestrator", "a2a-router", "training-challenges"],
      "when": ["requested_worker not in policy route", "privileged_route && approval.id is null"],
      "mitre_attack": ["Valid Accounts", "Account Manipulation"],
      "response": ["deny delegation", "persist the attempted route", "notify the SIEM worker"]
    },
    {
      "id": "ZB-AI-009",
      "title": "Untrusted evidence attempts to issue control instructions",
      "severity": "high",
      "log_sources": ["zodiac-context", "a2a-knowledge", "mem0"],
      "when": ["evidence_contains_instruction == true", "authority_section != context-policy"],
      "mitre_atlas": ["prompt injection", "data poisoning"],
      "response": ["render as quoted data", "exclude from action planning", "mark packet truncated or quarantined"]
    },
    {
      "id": "ZB-AI-010",
      "title": "Autonomous loop exceeds declared safety budget",
      "severity": "critical",
      "log_sources": ["orchestrator", "loop-engineering", "a2a-router"],
      "when": ["steps > max_steps", "retries > max_retries", "approval_required && approval.id is null"],
      "mitre_attack": ["Command and Scripting Interpreter", "Exfiltration Over Web Service"],
      "response": ["stop the loop", "persist an immutable checkpoint", "require human containment approval"]
    },
    {
      "id": "ZB-FRAUD-001",
      "title": "Synthetic transaction risk or mule-network signal requires review",
      "severity": "high",
      "log_sources": ["training-challenges", "zodiac-bank-orchestrator", "fraud-engine"],
      "when": ["fraud.risk_score >= review_threshold", "fraud.decision == review", "fraud.network.hub_detected == true"],
      "mitre_attack": ["Account Discovery", "Financial Theft"],
      "response": ["hold virtual operation", "open synthetic fraud case", "require independent fraud and compliance review"]
    },
    {
      "id": "ZB-AI-011",
      "title": "Agent-to-agent lateral movement or orchestrator route hijack",
      "severity": "critical",
      "log_sources": ["orchestrator", "a2a-router", "training-challenges"],
      "when": ["lateral_move.compromised_source == true", "orchestrator.route not in policy", "delegation path exceeds max hops"],
      "mitre_attack": ["Lateral Movement", "Use Alternate Authentication Material"],
      "response": ["deny the move", "quarantine the compromised agent", "persist the attempted route"]
    },
    {
      "id": "ZB-AI-012",
      "title": "Attacker-controlled telemetry carries instruction-like content",
      "severity": "critical",
      "log_sources": ["mcp-wrapper", "a2a-knowledge", "training-challenges"],
      "when": ["telemetry.source == attacker-controlled", "telemetry.instruction_markers > 0"],
      "mitre_atlas": ["AI agent tool poisoning", "indirect prompt injection"],
      "response": ["refuse the tool action", "preserve event origin", "require human review"]
    },
    {
      "id": "ZB-AI-013",
      "title": "Non-human identity lifecycle or delegation relay violation",
      "severity": "high",
      "log_sources": ["training-gate", "orchestrator", "a2a-router"],
      "when": ["credential.revoked or credential.expired", "credential.rotation_due", "delegation.subject reused", "delegation scope widened"],
      "mitre_attack": ["Use Alternate Authentication Material", "Valid Accounts"],
      "response": ["block the credential", "rotate and revoke", "escalate to compliance"]
    },
    {
      "id": "ZB-AI-014",
      "title": "Hidden or obfuscated multimodal instruction crosses to an action",
      "severity": "high",
      "log_sources": ["aurora", "a2a-knowledge", "training-challenges"],
      "when": ["multimodal.hidden_markers > 0", "multimodal.obfuscated == true", "channel == untrusted"],
      "mitre_atlas": ["multimodal prompt injection", "obfuscated prompt injection"],
      "response": ["quarantine the content", "deny the cross-modal action", "preserve the source channel"]
    },
    {
      "id": "ZB-AI-015",
      "title": "GenAI trace is missing spans or correlation",
      "severity": "medium",
      "log_sources": ["orchestrator", "a2a-router", "mcp-wrapper"],
      "when": ["trace.orphaned_spans > 0", "trace.security_events == 0", "agent span lacks tool span"],
      "mitre_atlas": ["evasion"],
      "response": ["attach the missing spans", "correlate the trace", "open a detection-gap task"]
    },
    {
      "id": "ZB-AI-016",
      "title": "Runtime supply-chain drift, registry squat, or rug-pull",
      "severity": "critical",
      "log_sources": ["mcp-wrapper", "dependency-sweeper", "orchestrator"],
      "when": ["artifact.digest != pinned", "manifest.digest changed after approval", "registry.name near-collision"],
      "mitre_attack": ["Supply Chain Compromise", "Poisoned Pipeline Execution"],
      "response": ["deny the artifact or tool", "pin the approved baseline", "open a supply-chain case"]
    },
    {
      "id": "ZB-AI-017",
      "title": "Deepfake or agentic fraud orchestration signal",
      "severity": "high",
      "log_sources": ["training-challenges", "fraud-engine", "orchestrator"],
      "when": ["deepfake.risk_score >= review_threshold", "scam.pretext_count > 0 and transfer_count > 0", "mule.hub_detected == true"],
      "mitre_attack": ["Financial Theft", "Account Discovery"],
      "response": ["hold the operation", "open a synthetic fraud case", "require fraud and compliance review"]
    },
    {
      "id": "ZB-AI-018",
      "title": "Detector regresses under mutation or transfer",
      "severity": "medium",
      "log_sources": ["training-challenges", "orchestrator", "evaluation"],
      "when": ["evaluation.regression_found == true", "evaluation.transfer_gap_found == true", "detector recall < threshold"],
      "mitre_atlas": ["adversarial evaluation"],
      "response": ["remediate the detector", "expand the corpus", "record the regression threshold"]
    }
  ]
}
